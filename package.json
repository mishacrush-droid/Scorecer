{
  "name": "scorecer-super-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "/usr/local/bin/node ./node_modules/vite/bin/vite.js",
    "build": "/usr/local/bin/node ./node_modules/typescript/bin/tsc -b && /usr/local/bin/node ./node_modules/vite/bin/vite.js build",
    "preview": "/usr/local/bin/node ./node_modules/vite/bin/vite.js preview",
    "test": "INLINE_PREVIEW=1 /usr/local/bin/node ./node_modules/vite/bin/vite.js build --ssr src/test-runner.ts --outDir dist-test && /usr/local/bin/node dist-test/test-runner.js && rm -rf dist-test"
  },
  "dependencies": {
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
